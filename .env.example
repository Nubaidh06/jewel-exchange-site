# Sanity CMS Configuration
NEXT_PUBLIC_SANITY_PROJECT_ID=rrsnwe4c
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity Write/Read Token (Used for migration/backend operations)
SANITY_API_TOKEN=your_sanity_token_here

# ─── Coming Soon Gate ────────────────────────────────────────────────
# Set to "true" to show the coming-soon page instead of the real site.
# Set to "false" (or remove) to launch the real site.
# Change this in Vercel → Settings → Environment Variables, then redeploy.
NEXT_PUBLIC_COMING_SOON=true

# Google Analytics 4 Measurement ID (Optional: e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Showroom In-Store Access Passcode & Session Secret
SHOWROOM_PASSCODE=jewel@2026
SHOWROOM_AUTH_SECRET=jewel_exchange_showroom_secure_2026
